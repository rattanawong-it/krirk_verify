# =============================================================
# Krirk Verify — ตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env แล้วแก้ค่า:  cp .env.example .env
# ห้าม commit ไฟล์ .env จริงเด็ดขาด
# =============================================================

# ---------- แอปพลิเคชัน ----------
NODE_ENV=development
# URL สาธารณะของระบบ (ใช้สร้างลิงก์ในอีเมลและ permalink)
APP_URL=http://localhost:3000
# ภาษาเริ่มต้น: th | en
DEFAULT_LOCALE=th

# ---------- ฐานข้อมูล (PostgreSQL 16) ----------
POSTGRES_USER=krirk
POSTGRES_PASSWORD=krirk_dev_password
POSTGRES_DB=krirk_verify
# ใช้ 5435 เพื่อไม่ชนกับ PostgreSQL ของโปรเจกต์อื่นบนเครื่อง dev (5432–5434 ถูกใช้อยู่)
POSTGRES_PORT=5435
ADMINER_PORT=8080
DATABASE_URL=postgresql://krirk:krirk_dev_password@localhost:5435/krirk_verify?schema=public

# ---------- Authentication (Auth.js v5) ----------
# สร้างด้วย: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-32-byte-base64-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# จำนวนครั้งที่ล็อกอินผิดก่อนล็อกบัญชี และระยะเวลาล็อก (นาที)
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=30

# ---------- PDPA / Crypto ----------
# pepper สำหรับ HMAC-SHA256 ของเลขบัตร/พาสปอร์ต — ห้ามเปลี่ยนหลังมีข้อมูลจริง
# สร้างด้วย: openssl rand -hex 32
IDENTIFIER_PEPPER=change-me-64-hex-chars
# คีย์ AES-256-GCM (32 bytes, hex 64 ตัวอักษร)
# สร้างด้วย: openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-hex-chars
# ระยะเวลาเก็บคำขอก่อน anonymize (วัน)
DATA_RETENTION_DAYS=1825

# ---------- ระบบทะเบียน (Registry API) ----------
# mock = ใช้ Mock API ภายใน | http = เชื่อม API จริงของฝ่ายทะเบียน
REGISTRY_CLIENT=mock
REGISTRY_API_URL=http://localhost:3000/api/mock/registry
REGISTRY_API_KEY=
REGISTRY_TIMEOUT_MS=10000
# เปิด/ปิด route /api/mock/registry (ต้องเป็น false บน production)
MOCK_REGISTRY_ENABLED=true

# จำนวนระเบียนต่อหน้าที่ดึงจากระบบทะเบียนระหว่าง sync
SYNC_PAGE_SIZE=500

# ---------- Cron ----------
# secret ที่ system cron ต้องส่งมาใน header x-cron-secret (อย่างน้อย 16 ตัวอักษร)
# สร้างด้วย: openssl rand -hex 24
CRON_SECRET=change-me-random-string
# ตารางเวลา sync (แสดงผลบนหน้า /staff/sync เท่านั้น — ตั้งเวลาจริงที่ system cron)
SYNC_CRON_SCHEDULE="0 2 * * *"

# ---------- Rate Limit ----------
RATE_LIMIT_USER_PER_HOUR=30
RATE_LIMIT_IP_PER_HOUR=60
RATE_LIMIT_BATCH_PER_DAY=5
BATCH_MAX_ROWS=500

# ---------- Verification ----------
# อายุของ permalink ผลตรวจสอบ (วัน)
RESULT_LINK_EXPIRES_DAYS=90
# SLA ของคำขอที่รอเจ้าหน้าที่พิจารณา (ชั่วโมง) — เตือนเมื่อใช้ไป 75%, ไฮไลต์เมื่อเกิน
REVIEW_SLA_HOURS=24

# ---------- Email (SMTP มหาวิทยาลัย) ----------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Krirk Verify <no-reply@krirk.ac.th>"
# dev: Mailpit ดักอีเมลไว้ ดูได้ที่ http://localhost:8025
MAILPIT_UI_PORT=8025

# ---------- Seed (dev เท่านั้น) ----------
# รหัสผ่านของบัญชีทดสอบทุกบทบาทที่ prisma/seed.ts สร้าง (ไม่สร้างเมื่อ NODE_ENV=production)
SEED_DEMO_PASSWORD=Krirk2569
