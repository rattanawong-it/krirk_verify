# =============================================================
# Krirk Verify — ตัวแปรสภาพแวดล้อม production (docker/docker-compose.prod.yml)
# cp .env.prod.example .env.prod  แล้วแก้ทุกค่าที่เป็น change-me
# ไฟล์นี้มีความลับ: chmod 600 .env.prod และห้าม commit
# ไม่ใช้ชื่อ .env.production เพราะ next build/next start บนเครื่อง dev จะอ่านไฟล์ชื่อนั้นอัตโนมัติและทับค่าใน .env
# ตารางอธิบายตัวแปรทั้งหมด: README.md หัวข้อ "ตัวแปรสภาพแวดล้อม"
# =============================================================

# ---------- Docker / nginx ----------
# ชื่อโดเมนที่ nginx ให้บริการ (ต้องตรงกับใบรับรองใน docker/nginx/certs)
NGINX_SERVER_NAME=verify.krirk.ac.th
HTTP_PORT=80
HTTPS_PORT=443
# ชื่อ/แท็ก image ที่ build หรือโหลดมา
APP_IMAGE=krirk-verify
APP_TAG=latest

# ---------- แอปพลิเคชัน ----------
APP_URL=https://verify.krirk.ac.th

# ---------- ฐานข้อมูล ----------
# DATABASE_URL ประกอบให้อัตโนมัติใน compose — รหัสผ่านใช้เฉพาะ a-z A-Z 0-9 (สร้างด้วย openssl rand -hex 24)
POSTGRES_USER=krirk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=krirk_verify

# ---------- Authentication ----------
# openssl rand -base64 32
AUTH_SECRET=change-me
# ห้ามตั้ง AUTH_URL หลัง nginx — Auth.js จะแทน origin ของคำขอด้วยค่านี้ ทำให้ rewrite ภาษาของ proxy.ts
# กลายเป็นการยิงออกไปนอก container (หน้าแรกตอบ 500) · ใช้ AUTH_TRUST_HOST อ่าน X-Forwarded-* จาก nginx แทน
AUTH_TRUST_HOST=true
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=30

# ---------- PDPA / Crypto ----------
# ⚠ สำรองสองค่านี้แยกจากไฟล์ backup ฐานข้อมูล — หายแล้วถอดรหัส/ค้นหาข้อมูลเดิมไม่ได้อีก และห้ามเปลี่ยนหลังมีข้อมูลจริง
# openssl rand -hex 32
IDENTIFIER_PEPPER=change-me
# openssl rand -hex 32
ENCRYPTION_KEY=change-me
DATA_RETENTION_DAYS=1825

# ---------- ระบบทะเบียน ----------
# http = API จริงของฝ่ายทะเบียน · mock = ข้อมูลสมมติ (ใช้บนเครื่องทดสอบ/UAT เท่านั้น)
REGISTRY_CLIENT=http
REGISTRY_API_URL=https://registry.krirk.ac.th/api/v1
REGISTRY_API_KEY=change-me
REGISTRY_TIMEOUT_MS=10000
# production ต้องเป็น false (ถ้าใช้ REGISTRY_CLIENT=mock บน UAT ให้ตั้ง true และ REGISTRY_API_URL=http://localhost:3000/api/mock/registry)
MOCK_REGISTRY_ENABLED=false
SYNC_PAGE_SIZE=500

# ---------- Cron ----------
# openssl rand -hex 24
CRON_SECRET=change-me
# แสดงผลบนหน้า /staff/sync — ต้องตรงกับ crontab จริง (docker/cron/krirk-verify.cron)
SYNC_CRON_SCHEDULE="0 2 * * *"

# ---------- Rate Limit / Verification ----------
RATE_LIMIT_USER_PER_HOUR=30
RATE_LIMIT_IP_PER_HOUR=60
BATCH_MAX_ROWS=500
RESULT_LINK_EXPIRES_DAYS=90
REVIEW_SLA_HOURS=24

# ---------- Email (SMTP มหาวิทยาลัย) ----------
SMTP_HOST=smtp.krirk.ac.th
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@krirk.ac.th
SMTP_PASSWORD=change-me
SMTP_FROM="Krirk Verify <no-reply@krirk.ac.th>"

# ---------- สำรองข้อมูล (scripts/backup-db.sh) ----------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30
